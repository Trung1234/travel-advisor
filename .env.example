AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://agent-foundry-65.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
SERPAPI_API_KEY=
SERPAPI_LIMIT=5
API_BASE_URL=http://localhost:8000
TTS_ENGINE=pyttsx3
TTS_VOICE=
TTS_RATE=180
TTS_VOLUME=1.0
TTS_OUTPUT_DIR=
TTS_OUTPUT_PREFIX=tts
TTS_CLEANUP=true
TTS_EXTENSION=wav
TTS_AUTOPLAY=true
TTS_LANG=en-US
TTS_MAX_CHARS=4000
TTS_DEFAULT_TEXT=I'm sorry, I couldn't generate audio right now.
TTS_MEDIA_TYPE=audio/wav
TTS_FILENAME=reply.wav
TTS_CACHE_TTL=0
TTS_ENABLE_CACHE=false
TTS_ENGINE_TIMEOUT=30
TTS_DEBUG=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=7200

# RAG Configuration
RAG_ENABLED=false
RAG_PROVIDER=azure
RAG_AZURE_SEARCH_ENDPOINT=
RAG_AZURE_SEARCH_API_KEY=
RAG_INDEX_NAME=travel-docs
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=50
RAG_RETRIEVAL_TOP_K=10

